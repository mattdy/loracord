# ─── Discord ─────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# ─── MQTT ────────────────────────────────────────────────────────────────────
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
# Optional — leave blank if your broker has no auth
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Meshtastic ──────────────────────────────────────────────────────────────
# The root topic configured on your node (default: msh/REGION)
MQTT_ROOT_TOPIC=msh/EU_868

# OPTIONAL — your gateway node's ID (used for echo prevention + the downlink
# envelope). Leave blank and the bridge discovers it from the first packet your
# node uplinks. Only set it if your broker carries more than one gateway.
# Accepts the hex form the Meshtastic app shows (!a1b2c3d4) or a plain decimal.
GATEWAY_NODE_ID=

# ─── Channel Mappings ────────────────────────────────────────────────────────
# Map Meshtastic channel names to Discord channel IDs.
# Format: MeshtasticChannelName:DiscordChannelId
# Comma-separated for multiple channels.
# The Meshtastic channel name must exactly match the channel name on the node.
# Example: LongFast:1234567890123456789,Private:9876543210987654321
#
# Downlinks address channels by their slot number on the node (0 = primary),
# which the bridge learns from the first packet it sees on each channel. To skip
# that wait, pin the index between the name and the Discord channel ID:
#   MeshtasticChannelName:ChannelIndex:DiscordChannelId
# Example: LongFast:0:1234567890123456789,Private:2:9876543210987654321
CHANNEL_MAP=LongFast:YOUR_DISCORD_CHANNEL_ID_HERE

# ─── Optional ────────────────────────────────────────────────────────────────
# Echo each bridged Discord message back into its channel, showing exactly what
# reached the mesh. Long messages are truncated on the way out, so the echo is
# how you see what actually got sent. Off by default.
CONFIRM_SENDS=false

# Suppress the 🟢 "…is now on the mesh" notice posted the first time each node
# is heard, so only actual messages are bridged into Discord. Off by default.
SUPPRESS_NODE_EVENTS=false

# How long (ms) to keep node info cached before it's considered stale
NODE_CACHE_TTL_MS=3600000

# How long (ms) to remember a packet's ID, so the same mesh packet uplinked by
# a second gateway is recognised as a copy rather than bridged again. Only
# matters if your broker carries more than one gateway. Set to 0 to disable.
DEDUPE_WINDOW_MS=300000

# Log verbosity: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info
